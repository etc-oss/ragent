// ragent workspace — the two-side HUMAN / MACHINE layout (ADR-0005).
//
// This is a TEMPLATE: the flake substitutes @bash@ (absolute bash) and @paneBin@
// (the workspace tools' bin dir) so each pane sets its own PATH and never depends
// on the launching shell — a bare launch can't leave tools unfound. The launcher
// (tools/ragent-workspace.sh) exports the env these commands read:
//   RAGENT_MAIN    the human's main project tree (full .git)
//   RAGENT_CLONE   the agent's self-contained clone on agent/<task> (ADR-0016)
//   RAGENT_LOG     the agent log the machine tail pane follows
//   RAGENT_EDITOR  the editor to run (defaults to nvim; a config repo can override)
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    // HUMAN: neovim on the main tree + lazygit for review/observability.
    tab name="HUMAN" focus=true {
        pane split_direction="vertical" {
            pane name="editor" command="@bash@" {
                args "-c" "export PATH=@paneBin@:\"$PATH\"; cd \"$RAGENT_MAIN\" && exec \"${RAGENT_EDITOR:-nvim}\" ."
            }
            pane name="review (lazygit)" size="45%" command="@bash@" {
                args "-c" "export PATH=@paneBin@:\"$PATH\"; cd \"$RAGENT_MAIN\" && exec lazygit"
            }
        }
    }

    // MACHINE: the agent shell (top), with a bottom row of the agent log + a live
    // hardware-metrics pane (CPU / memory / disk / net / processes, via btop).
    tab name="MACHINE" {
        pane split_direction="horizontal" {
            pane name="agent" size="60%" command="@bash@" {
                args "-c" "export PATH=@paneBin@:\"$PATH\"; cd \"$RAGENT_CLONE\" && cat .ragent/README 2>/dev/null; exec @bash@"
            }
            pane split_direction="vertical" size="40%" {
                pane name="agent log" command="@bash@" {
                    args "-c" "export PATH=@paneBin@:\"$PATH\"; cd \"$RAGENT_CLONE\" && exec tail -n +1 -F \"$RAGENT_LOG\""
                }
                pane name="metrics (btop)" command="@bash@" {
                    args "-c" "export PATH=@paneBin@:\"$PATH\"; exec btop --preset 0"
                }
            }
        }
    }
}
