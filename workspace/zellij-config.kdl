// Neon/pastel workspace theme — Tokyo Night Moon (brighter accents), with green
// remapped to bright neon cyan so the pane chrome (frames, tabs, status bar) shows
// NO explicit green. Applied by tools/ragent-workspace.sh via `zellij --config`.
themes {
    ragent-neon {
        fg "#c8d3f5"
        bg "#1a1b26"
        black "#15161e"
        red "#ff757f"
        green "#86e1fc"     // neutralized: bright neon cyan instead of green
        yellow "#ffc777"
        blue "#82aaff"
        magenta "#c099ff"
        cyan "#86e1fc"
        white "#c8d3f5"
        orange "#ff966c"
    }
}
theme "ragent-neon"
pane_frames true
